{
  "name": "NEW_LIB",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/NEW_LIB.umd.cjs",
  "module": "./dist/NEW_LIB.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/NEW_LIB.js",
      "require": "./dist/NEW_LIB.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run build:lib && npm run build:site",
    "build:site": "vite build -c vite.config.ts --emptyOutDir",
    "build:lib": "vite build -c vite.config.lib.ts",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@excaliburjs/plugin-tiled": "0.32.0",
    "excalibur": "^0.32.0",
    "jsdom": "^25.0.1",
    "netplayjs": "^0.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4",
    "remixicon": "^4.9.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.7"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "react-github-btn": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3"
  },
  "packageManager": "pnpm@10.34.6"
}
